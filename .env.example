# Copia este archivo a .env y sustituye los valores REEMPLAZAR_*.
# No publiques el archivo .env con tus credenciales.
PORT=3000
API_KEY=REEMPLAZAR_POR_TU_API_KEY
API_KEYS=
API_KEY_LABELS=
API_KEY_PEPPER=REEMPLAZAR_POR_UN_PEPPER_PRIVADO_ESTABLE
BOOTSTRAP_API_KEYS=true
AUTO_PROVISION_DEFAULT_API_KEY=false
ADMIN_API_KEY=REEMPLAZAR_POR_TU_ADMIN_API_KEY
ALLOW_ANY_API_KEY=false
# Para un despliegue remoto, indica el origen publico de tu frontend.
CORS_ORIGIN=http://localhost:4201
INGEST_RATE_LIMIT_WINDOW_MS=10000
INGEST_RATE_LIMIT_MAX=200
# Vacio = modo en memoria. Para PostgreSQL, crea la base y ejecuta db:migrate.
# DATABASE_URL=postgres://REEMPLAZAR_USUARIO:REEMPLAZAR_PASSWORD@REEMPLAZAR_HOST:5432/REEMPLAZAR_BASE_DE_DATOS
# Codifica los caracteres especiales del usuario/password para una URL.
DATABASE_URL=
DATABASE_SSL=false
COMMANDER_NAME=default
TENANT_MODE=api_key
